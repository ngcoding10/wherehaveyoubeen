rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Your private logbook (everything you've logged, notes, home base). Only you.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Usernames are unique: one document per name, pointing at its owner.
    // Anyone signed in can look a name up (to send a friend request).
    // You can only claim a name for yourself, together with your own profile.
    match /usernames/{name} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && name.matches('^[a-z0-9_]{3,20}$')
        && getAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.username == name;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Public-to-friends profile: username, stats and visited places (no notes, dates or home).
    // Readable by you and by people on your friends list (friendship is mutual and must be accepted).
    match /profiles/{uid} {
      allow read: if request.auth != null
        && (request.auth.uid == uid || request.auth.uid in resource.data.friends);

      // you write your own profile; its username must be one you own
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.friends is list
        && request.resource.data.username is string
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid;

      // someone else may only add or remove THEMSELVES in your friends list:
      //  - add: only when you sent them a friend request (they are accepting it)
      //  - remove: always (unfriending)
      allow update: if request.auth != null && request.auth.uid != uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friends'])
        && (
          (request.resource.data.friends.toSet() == resource.data.friends.toSet().union([request.auth.uid].toSet())
            && exists(/databases/$(database)/documents/requests/$(request.auth.uid + '_' + uid)))
          ||
          request.resource.data.friends.toSet() == resource.data.friends.toSet().difference([request.auth.uid].toSet())
        );
    }

    // Friend requests, id = "<to>_<from>". Visible to both people; either can delete (accept/decline/cancel).
    match /requests/{id} {
      allow read: if request.auth != null
        && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to != request.auth.uid
        && id == request.resource.data.to + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['from', 'to', 'fromName', 'toName', 'createdAt']);
      allow delete: if request.auth != null
        && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
    }
  }
}
